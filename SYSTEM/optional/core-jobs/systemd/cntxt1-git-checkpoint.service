[Unit]
Description=cntxt1: git-checkpoint (safety-net vault commit)
After=network-online.target

[Service]
Type=oneshot
User={{USER}}
EnvironmentFile=/etc/cntxt1/core.env
Nice=10
MemoryMax=256M
TimeoutStartSec=120
ExecStart={{OPTIONAL_DIR}}/core-jobs/bin/jobwrap git-checkpoint --timeout 90 -- {{OPTIONAL_DIR}}/core-jobs/bin/git-checkpoint
