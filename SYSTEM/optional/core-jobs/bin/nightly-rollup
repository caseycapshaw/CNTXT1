#!/usr/bin/env bash
# nightly-rollup — the cloud core's evening housekeeping.
# Two jobs, both deterministic bash, no LLM:
#   1. Upstream framework check: is the public CNTXT1 kit ahead of what this
#      vault has adopted? Write/refresh/clear "Upstream kit updates (pending).md".
#   2. Roll past daily notes into ISO-week folders (SYSTEM/bin/rollup-daily-weeks.sh).
#
# This does NOT commit/push — cntxt1-git-checkpoint.timer (every 15 min) already
# covers that; whatever this script touches gets picked up by the next
# checkpoint. No desktop notification (headless host) — the pending note +
# SYSTEM/log.md line are the signal.
set -uo pipefail

export VAULT="${VAULT:?VAULT must be set (see /etc/cntxt1/core.env)}"
today="$(date +%F)"

echo "=== nightly-rollup run $(date) ==="
cd "$VAULT" || exit 1

# --- 1) Upstream framework check --------------------------------------------
upnote="$VAULT/Upstream kit updates (pending).md"
# Same baseline file the kit's sync-from-upstream.sh --reconcile uses.
cache_dir="$HOME/.claude/cache"
mkdir -p "$cache_dir"
adopted_f="$cache_dir/cntxt1-upstream-adopted"
seen_f="$cache_dir/cntxt1-upstream-seen"

# Drain self-originated commits from the pending-upstream queue first.
[ -x "$VAULT/SYSTEM/bin/sync-from-upstream.sh" ] && timeout 60 "$VAULT/SYSTEM/bin/sync-from-upstream.sh" --reconcile || true
if git -C "$VAULT" remote get-url upstream >/dev/null 2>&1; then
  if git -C "$VAULT" fetch upstream --quiet 2>/dev/null; then
    tip="$(git -C "$VAULT" rev-parse upstream/main 2>/dev/null)"
    adopted="$(cat "$adopted_f" 2>/dev/null)"
    [ -z "$adopted" ] && { printf '%s\n' "$tip" > "$adopted_f"; adopted="$tip"; }
    pending="$(git -C "$VAULT" log --oneline "$adopted..$tip" 2>/dev/null)"
    if [ -z "$pending" ]; then
      [ -f "$upnote" ] && rm -f "$upnote" && echo "upstream check: baseline current — removed stale pending note."
      echo "upstream check: no unadopted kit commits."
    else
      count="$(printf '%s\n' "$pending" | wc -l | tr -d ' ')"
      {
        echo "# Upstream kit updates (pending)"
        echo
        echo "> Auto-generated by nightly-rollup — do not edit; rewritten each run and"
        echo "> deleted automatically once the adopted baseline catches up."
        echo
        echo "The public CNTXT1 kit has **$count commit(s)** this vault hasn't adopted"
        echo "(baseline \`$(printf '%.7s' "$adopted")\` → upstream \`$(printf '%.7s' "$tip")\`):"
        echo
        printf '%s\n' "$pending" | awk '{sha=$1; sub(/^[^ ]+ /,""); printf "- `%s` %s\n", sha, $0}'
        echo
        echo "**Next session:** ask Claude to *\"review the pending upstream kit updates\"* —"
        echo "it should interview you commit-by-commit (adopt / skip / defer), apply the"
        echo "keepers via [[Pull Framework Updates from CNTXT1]], update the baseline file"
        echo "(\`$adopted_f\`), and delete this note (the next checkpoint commit + push"
        echo "carries the change)."
        echo
        echo "- [ ] Review $count pending upstream kit commit(s) #action"
      } > "$upnote"
      echo "upstream check: $count unadopted commit(s) — pending note written."
      if [ "$(cat "$seen_f" 2>/dev/null)" != "$tip" ]; then
        printf '%s\n' "$tip" > "$seen_f"
      fi
    fi
  else
    echo "upstream check: fetch failed (offline?) — skipped."
  fi
else
  echo "upstream check: no upstream remote configured — skipped."
fi

# --- 2) Roll past daily notes into ISO-week folders -------------------------
if [ -x "$VAULT/SYSTEM/bin/rollup-daily-weeks.sh" ]; then
  "$VAULT/SYSTEM/bin/rollup-daily-weeks.sh" || echo "daily rollup failed — continuing."
else
  echo "daily rollup: SYSTEM/bin/rollup-daily-weeks.sh not found or not executable — skipped."
fi

echo "- $today — nightly-rollup ran (upstream check + daily-weeks rollup) on the cloud core #auto" >> "$VAULT/SYSTEM/log.md"

exit 0
