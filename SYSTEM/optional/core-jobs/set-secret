#!/usr/bin/env bash
# set-secret — store one credential for systemd LoadCredential= in
# /etc/credstore (root:root, 0600). The value is read from stdin or a hidden
# prompt — NEVER from argv (argv lands in shell history and `ps`).
#
#   sudo ./set-secret restic-password            # hidden prompt
#   pass show foo | sudo ./set-secret backup-key-id   # from a pipe
#   sudo ./set-secret --list                      # names + sizes, never values
#   sudo ./set-secret --rm NAME
#
# Units then declare `LoadCredential=<name>`; the job reads
# $CREDENTIALS_DIRECTORY/<name>. Names: lowercase letters, digits, - . _
set -euo pipefail
DIR="${CREDSTORE_DIR:-/etc/credstore}"
[ "$(id -u)" = 0 ] || { [ -n "${CREDSTORE_DIR:-}" ] || { echo "set-secret: run as root (sudo)" >&2; exit 1; }; }

case "${1:-}" in
  --list) find "$DIR" -maxdepth 1 -type f -exec wc -c {} + 2>/dev/null | grep -v ' total$'; exit 0 ;;
  --rm) name="${2:?usage: set-secret --rm NAME}"; rm -f -- "$DIR/$name"; echo "removed $name"; exit 0 ;;
  ''|-h|--help) sed -n '2,13p' "$0"; exit 0 ;;
esac
name="$1"
case "$name" in *[!a-z0-9._-]*|.*|'') echo "set-secret: bad name '$name'" >&2; exit 2 ;; esac

umask 077
install -d -m 0700 "$DIR"
tmp="$(mktemp "$DIR/.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
if [ -t 0 ]; then
  printf 'value for %s (hidden): ' "$name" >&2
  IFS= read -rs value; echo >&2
  printf '%s' "$value" > "$tmp"
else
  cat > "$tmp"
fi
[ -s "$tmp" ] || { echo "set-secret: empty value — not written" >&2; exit 1; }
chmod 0600 "$tmp"
mv -f "$tmp" "$DIR/$name"
trap - EXIT
echo "set-secret: wrote $DIR/$name ($(wc -c < "$DIR/$name" | tr -d ' ') bytes)"
