# /etc/cntxt1/core.env — NON-secret host config for every cntxt1 job on this
# host (world-readable is fine; secrets never go here — see `set-secret`).
# install.sh copies this to /etc/cntxt1/core.env ONLY if that file is absent
# and never overwrites it.
VAULT={{VAULT}}
TZ={{TZ}}

# Dead-man's-switch pings (healthchecks.io or any compatible service). The
# base URL usually embeds your project ping key, so treat it as semi-private:
#   https://hc-ping.com/<project-ping-key>
# jobwrap appends /<job>/start, /<job>/<exit-code>. Leave empty to disable.
HC_PING_BASE=

# Failure alerts (ntfy.sh or a self-hosted ntfy). Use an unguessable topic
# name; jobwrap POSTs a secret-free "job failed" line here. Empty = disabled.
NTFY_URL=

# git-checkpoint pushes only when this is 1 — enable ONLY if `origin` is a
# private remote you control.
CHECKPOINT_PUSH=0

# backup (restic + any S3-compatible store), e.g.
#   s3:https://<s3-endpoint>/<bucket>[/prefix]
RESTIC_REPOSITORY=
# Extra space-separated paths to include in the backup (optional).
BACKUP_EXTRA_PATHS=
